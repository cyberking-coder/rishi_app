# Copy to `.env` and fill in. Never commit the real .env.

# --- Server ---
PORT=4000
# Comma-separated list of allowed origins for CORS (the Flutter app uses native http,
# but this matters if you ever add a web client). Use * only in development.
CORS_ORIGIN=*

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rishi
DB_PASSWORD=change-me
DB_NAME=anurag_rishi

# --- Auth ---
# Generate a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d

# --- Media storage ---
# Directory where source media files live (served via signed, auth-checked stream/download).
MEDIA_DIR=./uploads
